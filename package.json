{
  "name": "wedflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:seed": "prisma db seed",
    "auth:secret": "node scripts/init-auth-secret.mjs",
    "test:auth": "node --conditions=react-server --import tsx --test tests/auth.test.ts",
    "test:management": "node --conditions=react-server --import tsx --test tests/management.test.ts",
    "test:qr": "node --conditions=react-server --import tsx --test tests/qr-invitation.test.ts",
    "test:guests": "node --conditions=react-server --import tsx --test tests/guests.test.ts",
    "test:guests:e2e": "node --conditions=react-server --import tsx scripts/test-guests-e2e.ts",
    "test:checkins": "node --conditions=react-server --import tsx --test tests/checkins.test.ts",
    "test:precheckins": "node --conditions=react-server --import tsx --test tests/precheckins.test.ts",
    "test:precheckins:e2e": "node --conditions=react-server --import tsx scripts/test-precheckins-e2e.ts",
    "test:precheckins:migration": "node --import tsx scripts/test-precheckin-migration.ts",
    "test:checkins:e2e": "node --conditions=react-server --import tsx scripts/test-checkins-e2e.ts",
    "test:checkins:migration": "node --import tsx scripts/test-checkin-migration.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth:e2e": "node --conditions=react-server --import tsx scripts/test-auth-e2e.ts",
    "test:ui": "node --conditions=react-server --import tsx scripts/test-ui-redesign.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pngjs": "^7.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
